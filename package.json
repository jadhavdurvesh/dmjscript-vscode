{
  "name": "dmjscript",
  "displayName": "DMJScript",
  "description": "Official DMJScript programming language support for Visual Studio Code",
  "version": "1.3.0",
  "publisher": "durveshjadhav",
  "license": "MIT",
  "icon": "icon.png",

  "main": "./src/extension.js",

  "activationEvents": [
    "*"
  ],

  "engines": {
    "vscode": "^1.80.0"
  },

  "categories": [
    "Programming Languages"
  ],

  "keywords": [
    "dmjscript",
    "dmj",
    "programming-language",
    "arduino",
    "embedded",
    "iot",
    "robotics"
  ],

  "repository": {
    "type": "git",
    "url": "https://github.com/jadhavdurvesh/dmjscript-vscode.git"
  },

  "contributes": {
    "languages": [
      {
        "id": "dmj",
        "aliases": [
          "DMJScript",
          "dmj"
        ],
        "extensions": [
          ".dmj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],

    "grammars": [
      {
        "language": "dmj",
        "scopeName": "source.dmj",
        "path": "./syntaxes/dmj.tmLanguage.json"
      }
    ],

    "snippets": [
      {
        "language": "dmj",
        "path": "./snippets/dmj.code-snippets"
      }
    ],

    "commands": [
  {
    "command": "dmjscript.run",
    "title": "Run DMJScript",
    "icon": "$(play)"
  }
],

    "menus": {
  "editor/title": [
    {
      "command": "dmjscript.run",
      "when": "resourceExtname == .dmj",
      "group": "navigation"
    }
  ]
}
  }
}